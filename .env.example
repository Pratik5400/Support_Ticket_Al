# VoltWay Networks · SupportAI Environment Configuration Template
# Copy this file to '.env' in the project root:
#   Windows: Copy-Item .env.example .env
#   Linux/macOS: cp .env.example .env

# MongoDB Connection Configuration (defaults to local MongoDB server)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=voltway_supportai

# Google Gemini API Key (optional - internal rule-based fallback activates if omitted)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Initial Administrator Credentials (auto-provisioned on startup if not existing)
ADMIN_NAME=Support Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password_at_least_8_chars
