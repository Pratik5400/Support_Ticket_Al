# Streamlit Community Cloud Secrets Configuration Template
# In Streamlit Cloud: App Dashboard -> Settings (gear icon) -> Secrets
# Paste the content below and replace with your actual values:

# MongoDB Atlas Connection URI (from https://cloud.mongodb.com)
MONGO_URI = "mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority"
MONGO_DB_NAME = "voltway_supportai"

# Google Gemini API Key (optional - internal rule fallback activates if omitted)
# Get from https://aistudio.google.com/
GEMINI_API_KEY = "your_actual_gemini_api_key_here"

# Administrator Account Credentials (auto-provisioned on startup)
ADMIN_NAME = "Support Administrator"
ADMIN_EMAIL = "admin@supportai.com"
ADMIN_PASSWORD = "ChooseAStrongPassword123"
